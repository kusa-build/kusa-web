---
import KusaAsciiHero from "../components/KusaAsciiHero.astro";
import "../styles/kusa-landing.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Kusa builds software that works automatically." />
    <meta name="theme-color" content="#1d2021" />
    <meta property="og:title" content="Kusa — Automatic software" />
    <meta property="og:description" content="Kusa builds software that works automatically." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <title>Kusa — Automatic software</title>
  </head>
  <body>
    <main>
      <KusaAsciiHero>
        <section class="site-section" id="purpose" hidden>
          <p class="section-lede" tabindex="-1">
            Software should work automatically.
          </p>
          <p class="section-body">
            We keep systems small and boring on purpose. Every moving part is one
            more thing that wakes you up at night, so we build the fewest parts
            that do the whole job — then we let them run.
          </p>
        </section>

        <section class="site-section" id="values" hidden>
          <p class="section-lede" tabindex="-1">
            The systems we build should:
          </p>
          <ul class="section-list">
            <li>Carry a task from request to result, unattended.</li>
            <li>Recover from failure instead of paging someone.</li>
            <li>Disappear into the workflow they serve.</li>
          </ul>
        </section>

        <section class="site-section" id="posts" hidden>
          <p class="section-lede" tabindex="-1">
            Nothing here yet. First post soon.
          </p>
        </section>

        <section class="site-section" id="contact" hidden>
          <p class="section-lede" tabindex="-1">
            Have something that should run itself?
          </p>
          <a class="section-link" href="mailto:hello@kusa.build">hello@kusa.build</a>
        </section>
      </KusaAsciiHero>
    </main>
  </body>
</html>
