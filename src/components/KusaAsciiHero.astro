<section class="ascii-screen" id="kusa-ascii-stage" aria-label="Interactive Kusa ASCII art">
  <canvas
    class="ascii-canvas"
    id="kusa-ascii-canvas"
    role="img"
    aria-label="KUSA rotating as three-dimensional ASCII art, morphing through a loading ring into AUTOMATIC"
  ></canvas>

  <button
    class="ascii-color-control"
    id="kusa-ascii-control"
    type="button"
    aria-label="Change the ASCII art color palette"
  ></button>

  <div class="ascii-brand" aria-hidden="true">
    <b>KUSA</b>
    <span>automatic software</span>
  </div>

  <div class="ascii-readout" aria-hidden="true">
    <span>[ <b id="kusa-ascii-word">KUSA</b> ]</span>
    <span>press anywhere&nbsp; / &nbsp;<b id="kusa-ascii-palette">PACIFIC</b>&nbsp; <i id="kusa-ascii-cycle">01</i></span>
  </div>

  <span class="screen-reader-text" id="kusa-ascii-live-word" aria-live="polite">KUSA</span>

  <noscript>
    <pre class="ascii-fallback" aria-label="KUSA">.::+**####**+::.  .::+**####**+::.  .::+**####**+::.  .::+**####**+::.
   K   K             U   U              SSSS              AAA
   K K               U   U             S                 A   A
   KK                U   U              SSS              AAAAA
   K K               U   U                 S             A   A
   K   K              UUU              SSSS              A   A</pre>
  </noscript>
</section>

<script>
  import "../scripts/kusa-ascii-hero";
</script>
